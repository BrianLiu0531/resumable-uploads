# Local development (see README). Never commit .env.
DEBUG=1
DATABASE_URL=postgres://postgres:postgres@localhost:5440/uploads
UPLOAD_STORAGE=local          # or s3
# S3_BUCKET=resumable-uploads-demo-123456789012
# AWS_REGION=ap-southeast-2   # credentials come from the usual AWS sources

# Limits (defaults shown)
# MAX_UPLOAD_SIZE=52428800        # 50 MiB per file
# MAX_CHUNK_SIZE=16777216         # 16 MiB per PATCH
# UPLOAD_TTL_HOURS=24             # files and unfinished uploads are deleted after this
# DAILY_BYTE_QUOTA=1073741824     # 1 GiB across all clients per rolling 24 h
# UPLOADS_PER_IP_PER_HOUR=20
